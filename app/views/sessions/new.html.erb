<div class="row justify-content-center mt-5">
  <div class="col-md-5 col-lg-4">
    <div class="card shadow-sm border-0 rounded-3">
      <div class="card-body p-4">
        <h2 class="h4 text-center mb-4 fw-bold text-dark">
          <%= t("sessions.new.title") %>
        </h2>

        <%= form_with url: session_path do |f| %>
          <div class="mb-3">
            <%= f.label :email, t("sessions.new.email_label"), class: "form-label text-muted small fw-bold" %>
            <%= f.email_field :email, required: true, autofocus: true, autocomplete: "email", class: "form-control" %>
          </div>

          <div class="mb-4">
            <%= f.label :password, t("sessions.new.password_label"), class: "form-label text-muted small fw-bold" %>
            <%= f.password_field :password, required: true, autocomplete: "current-password", class: "form-control" %>
          </div>

          <div class="d-grid">
            <%= f.submit t("sessions.new.submit_button"), class: "btn btn-dark py-2 fw-semibold" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>