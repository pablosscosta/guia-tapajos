<div class="container my-4" style="max-width: 800px;">
  <div class="card shadow-sm">
    <div class="card-body p-4">
      <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
          <span class="badge bg-secondary mb-2"><%= @poi.category %></span>
          <h1 class="card-title h2 mb-1"><%= @poi.name %></h1>
          <p class="text-muted"><%= @poi.address %></p>
        </div>
      </div>

      <hr>

      <div class="mb-4">
        <h5 class="fw-bold">Sobre o local</h5>
        <p class="card-text"><%= @poi.description %></p>
      </div>

      <div class="mb-4 p-3 bg-light rounded">
        <h6 class="fw-bold text-secondary mb-2">Coordenadas Geográficas</h6>
        <div class="row text-center">
          <div class="col-6 border-end">
            <small class="d-block text-muted">Latitude</small>
            <strong><%= @poi.latitude %></strong>
          </div>
          <div class="col-6">
            <small class="d-block text-muted">Longitude</small>
            <strong><%= @poi.longitude %></strong>
          </div>
        </div>
      </div>

      <div class="d-flex justify-content-between align-items-center pt-3 border-top">
        <%= link_to "Voltar para a lista", pois_path, class: "btn btn-outline-secondary" %>
        <div>
          <%= link_to "Editar", edit_poi_path(@poi), class: "btn btn-primary me-2" %>
          <%= button_to "Excluir", poi_path(@poi), method: :delete, data: { turbo_confirm: "Tem certeza?" }, class: "btn btn-outline-danger d-inline" %>
        </div>
      </div>
    </div>
  </div>
</div>