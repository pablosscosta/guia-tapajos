<div class="container my-4">
  <h1 class="mb-4">Pontos de Interesse (POIs)</h1>

  <div class="card mb-4 shadow-sm">
    <div class="card-body">
      <%= form_with url: pois_path, method: :get, local: true, class: "row g-3 align-items-end", id: "filter-form", data: { controller: "geolocation" } do |f| %>
        
        <div class="col-md-3">
          <%= f.label :query, "Buscar", class: "form-label fw-bold" %>
          <%= f.text_field :query, value: params[:query], placeholder: "Nome ou endereço...", class: "form-control" %>
        </div>

        <div class="col-md-3">
          <%= f.label :category, "Categoria", class: "form-label fw-bold" %>
          <%= f.select :category, options_for_select([["Todas", ""]] + Category.pluck(:name), params[:category]), {}, class: "form-select" %>
        </div>

        <div class="col-md-2">
          <%= f.label :radius, "Raio (km)", class: "form-label fw-bold" %>
          <%= f.number_field :radius, value: params[:radius], placeholder: "20", class: "form-control" %>
        </div>

        <%= f.hidden_field :latitude, value: params[:latitude], id: "latitude_field", data: { geolocation_target: "latitude" } %>
        <%= f.hidden_field :longitude, value: params[:longitude], id: "longitude_field", data: { geolocation_target: "longitude" } %>

        <div class="col-md-4 d-flex gap-2">
          <%= f.submit "Filtrar", class: "btn btn-primary flex-grow-1" %>
          <%= link_to "Limpar", pois_path, class: "btn btn-outline-secondary" %>
        </div>

      <% end %>
    </div>
  </div>

  <% if params[:latitude].present? && params[:longitude].present? %>
    <div class="alert alert-info py-2">
      <small>Filtrando por proximidade (Raio: <%= params[:radius].presence || 20 %> km)</small>
    </div>
  <% end %>

  <div class="row">
    <%= render partial: "poi_card", collection: @pois, as: :poi %>
  </div>