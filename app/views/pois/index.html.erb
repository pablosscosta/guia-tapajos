<div class="container my-4">
  <h1 class="mb-4">Pontos de Interesse (POIs)</h1>

  <div class="card mb-4 shadow-sm">
    <div class="card-body">
      <%= form_with url: pois_path, method: :get, local: true, class: "row g-3 align-items-end", id: "filter-form" do |f| %>
        
        <div class="col-md-3">
          <%= f.label :query, "Buscar", class: "form-label fw-bold" %>
          <%= f.text_field :query, value: params[:query], placeholder: "Nome ou endereço...", class: "form-control" %>
        </div>

        <div class="col-md-3">
          <%= f.label :category, "Categoria", class: "form-label fw-bold" %>
          <%= f.select :category, options_for_select([["Todas", ""]] + Poi.pluck(:category).compact.uniq, params[:category]), {}, class: "form-select" %>
        </div>

        <div class="col-md-2">
          <%= f.label :radius, "Raio (km)", class: "form-label fw-bold" %>
          <%= f.number_field :radius, value: params[:radius], placeholder: "20", class: "form-control" %>
        </div>

        <%= f.hidden_field :latitude, value: params[:latitude], id: "latitude_field" %>
        <%= f.hidden_field :longitude, value: params[:longitude], id: "longitude_field" %>

        <div class="col-md-4 d-flex gap-2">
          <%= f.submit "Filtrar", class: "btn btn-primary flex-grow-1" %>
          <%= link_to "Limpar", pois_path, class: "btn btn-outline-secondary" %>
        </div>

      <% end %>
    </div>
  </div>

  <% if params[:latitude].present? && params[:longitude].present? %>
    <div class="alert alert-info py-2">
      <small>📍 Filtrando por proximidade (Raio: <%= params[:radius].presence || 20 %> km)</small>
    </div>
  <% end %>

<div class="row">
    <% @pois.each do |poi| %>
      <div class="col-md-4 mb-3">
        <div class="card h-100 shadow-sm">
          <% if poi.cover_image.attached? %>
            <%= image_tag poi.cover_image, class: "card-img-top", style: "height: 200px; object-fit: cover;" %>
          <% end %>
          <div class="card-body">
            <h5 class="card-title"><%= poi.name %></h5>
            <h6 class="card-subtitle mb-2 text-muted"><%= poi.category %></h6>
            <p class="card-text"><%= poi.address %></p>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const latField = document.getElementById("latitude_field");
    const lngField = document.getElementById("longitude_field");
    const form = document.querySelector("#filter-form");

    // Tenta pegar a geolocalização ao carregar a página
    if (!latField.value && navigator.geolocation) {
      navigator.geolocation.getCurrentPosition(
        function(position) {
          latField.value = position.coords.latitude;
          lngField.value = position.coords.longitude;
        },
        function(error) {
          console.log("Geolocalização não permitida: ", error.message);
        }
      );
    }

    // Se o usuário preencheu o raio mas a latitude ainda está vazia, avisa ou tenta pegar na hora
    form.addEventListener("submit", function(event) {
      const radiusField = document.querySelector("input[name='radius']");
      if (radiusField.value && !latField.value && navigator.geolocation) {
        event.preventDefault();
        navigator.geolocation.getCurrentPosition(
          function(position) {
            latField.value = position.coords.latitude;
            lngField.value = position.coords.longitude;
            form.submit(); // Envia após preencher
          },
          function(error) {
            alert("Para usar o filtro de raio, é preciso permitir o acesso à localização.");
          },
          { timeout: 5000 }
        );
      }
    });
  });
</script>