<%= form_with(model: poi, class: "needs-validation") do |form| %>
  <% if poi.errors.any? %>
    <div class="alert alert-danger">
      <h5 class="alert-heading"><%= pluralize(poi.errors.count, "erro") %> impediram este POI de ser salvo:</h5>
      <ul class="mb-0">
        <% poi.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :name, "Nome do Ponto Turístico", class: "form-label fw-bold" %>
    <%= form.text_field :name, class: "form-control", placeholder: "Ex: Praia de Alter do Chão" %>
  </div>

  <div class="mb-3">
    <%= form.label :category, "Categoria", class: "form-label fw-bold" %>
    <%= form.text_field :category, class: "form-control", placeholder: "Ex: Praia, Cultura, Restaurante" %>
  </div>

  <div class="mb-3">
    <%= form.label :address, "Endereço", class: "form-label fw-bold" %>
    <%= form.text_field :address, class: "form-control", placeholder: "Ex: Alter do Chão, Santarém - PA" %>
  </div>

  <div class="row">
    <div class="col-md-6 mb-3">
      <%= form.label :latitude, "Latitude", class: "form-label fw-bold" %>
      <%= form.number_field :latitude, step: :any, class: "form-control", placeholder: "-2.504100" %>
    </div>
    <div class="col-md-6 mb-3">
      <%= form.label :longitude, "Longitude", class: "form-label fw-bold" %>
      <%= form.number_field :longitude, step: :any, class: "form-control", placeholder: "-54.954700" %>
    </div>
  </div>

  <div class="mb-3">
    <%= form.label :description, "Descrição", class: "form-label fw-bold" %>
    <%= form.text_area :description, rows: 4, class: "form-control", placeholder: "Descreva o que torna este local especial..." %>
  </div>

  <div class="d-flex justify-content-end gap-2">
    <%= link_to "Cancelar", pois_path, class: "btn btn-outline-secondary" %>
    <%= form.submit "Salvar Ponto de Interesse", class: "btn btn-primary" %>
  </div>
<% end %>