<%= form_with(model: poi, class: "needs-validation") do |form| %>
  <% if poi.errors.any? %>
    <div class="alert alert-danger">
      <h5 class="alert-heading"><%= pluralize(poi.errors.count, "erro") %> impediram este POI de ser salvo:</h5>
      <ul class="mb-0">
        <% poi.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :name, class: "form-label fw-bold" %>
    <%= form.text_field :name, class: "form-control", placeholder: t("pois.form.placeholders.name") %>
  </div>

  <div class="mb-3">
    <%= form.label :category, class: "form-label fw-bold" %>
    <%= form.text_field :category, class: "form-control", placeholder: t("pois.form.placeholders.category") %>
  </div>

  <div class="mb-3">
    <%= form.label :address, class: "form-label fw-bold" %>
    <%= form.text_field :address, class: "form-control", placeholder: t("pois.form.placeholders.address") %>
  </div>

  <div class="row">
    <div class="col-md-6 mb-3">
      <%= form.label :latitude, class: "form-label fw-bold" %>
      <%= form.number_field :latitude, step: :any, class: "form-control", placeholder: t("pois.form.placeholders.latitude") %>
    </div>
    <div class="col-md-6 mb-3">
      <%= form.label :longitude, class: "form-label fw-bold" %>
      <%= form.number_field :longitude, step: :any, class: "form-control", placeholder: t("pois.form.placeholders.longitude") %>
    </div>
  </div>

  <div class="mb-3">
    <%= form.label :cover_image, class: "form-label fw-bold" %>
    <%= form.file_field :cover_image, class: "form-control", accept: "image/*" %>
  </div>
  
  <div class="mb-3">
    <%= form.label :description, class: "form-label fw-bold" %>
    <%= form.text_area :description, rows: 4, class: "form-control", placeholder: t("pois.form.placeholders.description") %>
  </div>

  <div class="d-flex justify-content-end gap-2">
    <%= link_to t("pois.form.cancel"), pois_path, class: "btn btn-outline-secondary" %>
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>