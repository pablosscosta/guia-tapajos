<div class="container my-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 fw-bold text-dark mb-0">Meus Pontos de Interesse</h1>
    <%= link_to "Novo Ponto", new_poi_path, class: "btn btn-primary btn-sm px-3" %>
  </div>

  <% if @pois.any? %>
    <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
      <div class="table-responsive mb-0">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light text-uppercase fs-7 text-muted">
            <tr>
              <th class="py-3 px-4">Nome</th>
              <th class="py-3 px-4">Categoria</th>
              <th class="py-3 px-4">Status</th>
              <th class="py-3 px-4 text-end">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% @pois.each do |poi| %>
              <tr>
                <td class="py-3 px-4 fw-semibold text-dark">
                  <%= poi.name %>
                </td>
                <td class="py-3 px-4 text-muted">
                  <%= poi.category %>
                </td>
                <td class="py-3 px-4">
                  <% case poi.status.to_sym %>
                  <% when :approved %>
                    <span class="badge bg-success text-white px-2 py-1">Aprovado</span>
                  <% when :pending %>
                    <span class="badge bg-warning text-dark px-2 py-1">Pendente</span>
                  <% when :rejected %>
                    <span class="badge bg-danger text-white px-2 py-1">Rejeitado</span>
                  <% end %>
                </td>
                <td class="py-3 px-4 text-end">
                  <div class="d-flex justify-content-end align-items-center gap-2">
                    <%= link_to "Ver", poi_path(poi), class: "btn btn-outline-secondary btn-sm py-1 px-2" %>
                    <%= link_to "Editar", edit_poi_path(poi), class: "btn btn-outline-primary btn-sm py-1 px-2" %>
                    <%= button_to "Excluir", poi_path(poi), method: :delete, data: { turbo_confirm: "Tem certeza?" }, class: "btn btn-outline-danger btn-sm py-1 px-2", form: { class: "d-inline" } %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <div class="card shadow-sm border-0 rounded-3 text-center py-5">
      <div class="card-body">
        <p class="text-muted mb-4">Você ainda não cadastrou nenhum ponto de interesse.</p>
        <%= link_to "Cadastrar Primeiro Ponto", new_poi_path, class: "btn btn-primary px-4 fw-semibold" %>
      </div>
    </div>
  <% end %>
</div>