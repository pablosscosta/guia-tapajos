<h1>Painel Administrativo - POIs</h1>

<%= link_to "Novo POI", new_admin_poi_path, class: "btn" %>

<ul>
  <% @pois.each do |poi| %>
    <li>
      <strong><%= poi.name %></strong> (<%= poi.status %>)
      
      <% if poi.pending? %>
        <%= button_to "Aprovar", approve_admin_poi_path(poi), method: :patch %>
        <%= button_to "Rejeitar", reject_admin_poi_path(poi), method: :patch %>
      <% end %>
    </li>
  <% end %>
</ul>